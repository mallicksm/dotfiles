# .bashrc
source /usr/share/lsf/conf/profile.lsf 2>/dev/null
source ~/corp_settings.sh
source ~/dotfiles/bash_functions.sh
source ~/dotfiles/bash_aliases.sh

# Sensible cli setup
if [[ $- == *i* ]]; then
   stty sane
   set -o vi
   set -o physical
   set t_Co=256
   umask 002
   shopt -s cdspell
   shopt -s histappend
   shopt -s cdable_vars
   shopt -s autocd
   shopt -s direxpand
   # Arrow keys (vi-insert keymap, the default at prompt under `set -o vi`).
   # \e[A/B/C/D are the standard xterm escape sequences for Up/Down/Right/Left.
   # Rebinding Up/Down to history-SEARCH (vs the default cycle-all-history)
   # means: type a prefix, press Up, and only history entries starting with
   # that prefix surface. Way faster than scrolling through everything.
   # Atuin is reached via Ctrl-A only (see bash_atuin.sh, sourced at EOF).
   bind '"\e[A": history-search-backward'   # Up    -> filtered history back
   bind '"\e[B": history-search-forward'    # Down  -> filtered history fwd
   bind '"\e[C": forward-char'              # Right -> cursor right (default)
   bind '"\e[D": backward-char'             # Left  -> cursor left  (default)

   # Disable vi-edit-and-execute-command on `v` in vi-command mode.
   # `set -o vi` above puts readline in vi mode; Alt+v sends Esc-v which
   # enters command mode then fires `v`, which would launch $EDITOR on a
   # /tmp/bash-fc.XXXXXX scratch file -- looks like a random file opening
   # out of nowhere. Rebound to a harmless no-op redraw.
   bind -m vi-command '"v": redraw-current-line'
fi

export HISTCONTROL=ignoredups:erasedups
export HISTSIZE=100000
export HISTFILESIZE=100000
export HISTTIMEFORMAT="[%h-%d %T] "
export HISTIGNORE='pwd:exit:fg:bg:top:c:clear::b:.:..:...:....:z:h:history:ls:ll:ld'

export EDITOR=vi
export IGNOREEOF=1 # use exit to leave shell

# All atuin setup (PATH, init hooks, single Ctrl-A bind) lives in
# ~/.bash_atuin.sh, symlinked from ~/dotfiles/initrc/bash_atuin.sh by
# `dotfiles.sh linkrc`. atuin's default Up/Ctrl-R/? auto-binds are
# suppressed there via --disable-up-arrow / --disable-ctrl-r / --disable-ai,
# so the bashrc binds above (and fzf's Ctrl-R from bash_fzf.sh) survive
# intact. Sourced near the end purely for tidy grouping; ordering no
# longer matters for correctness.
[[ -f ~/.bash_atuin.sh ]] && source ~/.bash_atuin.sh
export PATH="$HOME/bin:$PATH"

# Verdi/nWave: auto-source custom Tcl (defines count_edges, etc.) at startup
export NOVAS_AUTO_SOURCE="$HOME/waves/count_edges.tcl"
# Verdi/nWave: always use the home prefs (novas.rc) + GUI layout (novas.conf),
# regardless of the directory Verdi is launched from. This keeps the Tcl
# command entry (cmd_enter_form=TRUE) and Interactive Console dock enabled.
export NOVAS_RC="$HOME/novas.rc"
export NOVAS_GUICONF="$HOME/novas.conf"
