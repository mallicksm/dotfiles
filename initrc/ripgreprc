# Don't let ripgrep vomit really long lines to my terminal, and show a preview.
--max-columns
150
--max-columns-preview
--max-count
10
--max-depth
10

# sort reverse last modified files
--sortr=modified

# Custom type groups -- usable as `rg --type <name>` or via the `rgrep` shell
# function (in ~/dotfiles/utils/bash_rgrep.sh). Names chosen to NOT shadow
# rg's built-in types (use `rg --type-list` to see those).
#
# chx     broad C/C++  (rg's built-in `c` is .c/.h only)
# vsv     verilog + systemverilog combined (broader than rg defaults)
# tclqel  TCL family used in this codebase
# mk      makefiles in any common name
#
# ONE GLOB PER --type-add. ripgrep does NOT treat a comma as a separator here:
# `--type-add 'vsv:*.v,*.sv'` defines a single glob literally named "*.v,*.sv",
# which matches no file on earth and makes `--type vsv` silently return
# nothing. Repeating --type-add for the same name is how you add globs to it.
# `rg --type-list` is the check: correct entries are listed ", "-separated.
#
# rgrep's -e/-E flags build two more type groups on the fly, named rgx and
# rgxn. Don't define those here.

--type-add
chx:*.c
--type-add
chx:*.h
--type-add
chx:*.cpp
--type-add
chx:*.hpp
--type-add
chx:*.S
--type-add
chx:*.cc
--type-add
chx:*.cxx
--type-add
chx:*.hxx
--type-add
chx:*.cppm
--type-add
chx:*.ipp

--type-add
vsv:*.v
--type-add
vsv:*.vh
--type-add
vsv:*.sv
--type-add
vsv:*.svh
--type-add
vsv:*.svp
--type-add
vsv:*.vp
--type-add
vsv:*.vhd
--type-add
vsv:*.vhdl

--type-add
tclqel:*.tcl
--type-add
tclqel:*.qel
--type-add
tclqel:*.fs

--type-add
mk:*.mk
--type-add
mk:Makefile
--type-add
mk:makefile
--type-add
mk:GNUmakefile
--type-add
mk:*.gmk
